# Generated by CMake from cmake/clangd.in -- do not edit and do not commit.
#
# clangd has no include paths for files that are not part of a translation unit
# in compile_commands.json (notably headers opened directly). These fallback
# flags let it resolve the project's own headers. Paths are absolute because
# clangd does not expand ${configDir} and relative -I paths are resolved
# against the opened file's directory.
If:
  PathMatch: .*\.(hpp|hh|h)$
CompileFlags:
  Add:
    - -I@IRLC_DIR@/include
    - -I@IRLC_DIR@/src
    - -I@GEN_PROTOBUF_SRC_DIR@
    - -std=c++20
